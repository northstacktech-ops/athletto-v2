{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "buildCommand": "nuxt build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/processar-notificacoes", "schedule": "0 12 * * *" },
    { "path": "/api/cron/gerar-mensalidades", "schedule": "0 12 1 * *" },
    { "path": "/api/cron/regua-cobranca", "schedule": "0 13 * * *" },
    { "path": "/api/cron/reconciliar-cobrancas", "schedule": "0 */4 * * *" }
  ]
}
